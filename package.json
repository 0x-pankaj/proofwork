{
  "name": "proofwork",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run typecheck lint test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "contracts:build": "bun run --cwd packages/contracts build",
    "contracts:test": "bun run --cwd packages/contracts test",
    "contracts:deploy:testnet": "bun run --cwd packages/contracts deploy:testnet",
    "e2e:testnet": "bun run --cwd packages/core e2e:testnet"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.1",
    "turbo": "^2.10.12",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "viem": "^2.56.3"
  }
}
