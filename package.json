{
  "name": "proofwork",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run typecheck lint test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "contracts:build": "bun run --cwd packages/contracts build",
    "contracts:test": "bun run --cwd packages/contracts test",
    "contracts:deploy:testnet": "bun run scripts/deploy-contracts.ts testnet",
    "e2e:testnet": "bun run --cwd packages/core e2e:testnet",
    "contracts:export": "bun run --cwd packages/contracts export",
    "circle:setup": "bun run scripts/circle-setup.ts",
    "contracts:deploy:mainnet": "bun run scripts/deploy-contracts.ts mainnet"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/bun": "^1.4.1",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.10.12",
    "typescript": "5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "viem": "^2.56.3"
  }
}
