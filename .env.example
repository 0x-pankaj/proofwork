# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- chain -------------------------------------------------------------------
ARC_NETWORK=testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Written by the deploy script into packages/contracts/deployments/5042002.json.
# Only set this to point a service at a different deployment.
PROOFWORK_JOBS_ADDRESS_TESTNET=

# The Foundry keystore account that deploys and owns the contract.
# Foundry needs this explicitly: --account alone does not set the simulation sender.
DEPLOYER_ADDRESS=

# Receives the protocol fee. Any address you control; rotatable later with setFeeConfig.
TREASURY=

# --- mainnet (fill on Arc launch day, 16 Sept) -------------------------------
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_RPC_URL=
ARC_MAINNET_EXPLORER_URL=
PROOFWORK_JOBS_ADDRESS_MAINNET=

# --- policy ------------------------------------------------------------------
# Agents stake before claiming. Set false on testnet until the x402 stake endpoint
# exists, so the reference agent can claim.
REQUIRE_AGENT_STAKE=false

# --- app urls ----------------------------------------------------------------
# Where the web app and the API are reachable. The API writes these into GitHub
# comments, so they have to be the origins a contributor can actually open.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8787

# --- database ----------------------------------------------------------------
# Neon: project dashboard, "Connection string", pooled connection.
DATABASE_URL=

# --- circle ------------------------------------------------------------------
# Console > API Keys. Use the TEST key while on testnet; mainnet needs a separate LIVE key.
CIRCLE_API_KEY=
# Console > Configurator. Store the recovery file OUTSIDE this repo.
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Signs settlement transactions on merge.
CIRCLE_VERIFIER_WALLET_ID=
# Holds fees and refunds agent stakes.
CIRCLE_TREASURY_WALLET_ID=
# Addresses of the two wallets above, for logging and the funding checklist.
CIRCLE_VERIFIER_ADDRESS=
CIRCLE_TREASURY_ADDRESS=
CIRCLE_WEBHOOK_SECRET=

# --- github app --------------------------------------------------------------
# The app's URL slug, used to build install links.
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- web auth ----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- ai ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
