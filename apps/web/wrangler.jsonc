{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofwork-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // The API is called through a binding, not over the public internet.
  "services": [{ "binding": "API", "service": "proofwork-api" }],
  "vars": {
    "ARC_NETWORK": "testnet",
    "PUBLIC_WEB_URL": "https://proofwork-web.0xpankaj.workers.dev",
    "PUBLIC_API_URL": "https://proofwork-api.0xpankaj.workers.dev",
    "PUBLIC_X402_URL": "https://proofwork-x402.0xpankaj.workers.dev",
    "GITHUB_APP_SLUG": "proofwork-arc"
  }
  // Secrets are set with `wrangler secret put`, never committed:
  //   AUTH_SECRET, AUTH_GITHUB_ID, AUTH_GITHUB_SECRET, INTERNAL_API_KEY
}
