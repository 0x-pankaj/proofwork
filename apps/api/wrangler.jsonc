{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofwork-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  // Needed by the Neon driver and the crypto used to verify webhook signatures.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every minute: reconcile the database against the escrow contract's events.
  // Hourly: expire bounties past their deadline and claims held without a pull request.
  // Daily: refund or forward the stakes behind claims that are over.
  "triggers": { "crons": ["*/1 * * * *", "0 * * * *", "0 3 * * *"] },
  "vars": {
    "ARC_NETWORK": "testnet",
    "PUBLIC_WEB_URL": "https://proofwork-web.0xpankaj.workers.dev",
    // Published on chain as an agent's ERC-8004 metadata URI, so it has to be this
    // service's real origin rather than a guess.
    "PUBLIC_API_URL": "https://proofwork-api.0xpankaj.workers.dev",
    // Compliance Engine is entitlement-gated; until it is granted, Circle screens the
    // transfer itself and denies it there.
    "COMPLIANCE_MODE": "wallet-only",
    // Agents stake to claim. Off only while the paid endpoints were unproven; the reference
    // agent has paid a stake on testnet since 10 Sept, so it stays on.
    "REQUIRE_AGENT_STAKE": "true"
  }
  // Secrets are set with `wrangler secret put` (or `bun run scripts/worker-secrets.ts`), never committed:
  //   DATABASE_URL, INTERNAL_API_KEY, GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET,
  //   CIRCLE_API_KEY, CIRCLE_ENTITY_SECRET, CIRCLE_VERIFIER_WALLET_ID, CIRCLE_VERIFIER_ADDRESS,
  //   CIRCLE_TREASURY_WALLET_ID; ARC_TESTNET_RPC_URL optionally, to use a private RPC.
}
